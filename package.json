{
  "name": "reelplane",
  "private": true,
  "type": "module",
  "description": "Open-source Reels SDK + video backend: resumable uploads, a Postgres job queue, a Go transcoding worker and a swipeable feed component.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm worker:lint && pnpm worker:test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:init": "tsx scripts/init-storage.ts && tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "services": "tsx scripts/doctor.ts",
    "worker:dev": "cd services/worker && go run ./cmd/worker",
    "worker:build": "cd services/worker && go build -o bin/ ./cmd/worker",
    "worker:lint": "node scripts/check-gofmt.mjs && cd services/worker && go vet ./...",
    "worker:test": "cd services/worker && go test ./...",
    "worker:chaos": "pnpm worker:build && cd services/worker && go run ./cmd/chaos",
    "worker:up": "docker compose --profile worker up -d --build worker",
    "showcase:clips": "node scripts/prepare-licensed-clips.mjs",
    "showcase:seed": "tsx scripts/seed-showcase.ts",
    "bench:seed": "tsx scripts/seed-showcase.ts --bench",
    "demo": "pnpm --filter @reelplane/web dev:lan",
    "showcase:reset": "tsx scripts/reset-showcase.ts",
    "phone": "tsx scripts/phone.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@reelplane/db": "workspace:*",
    "@reelplane/storage": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
