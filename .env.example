# Reelplane environment. Copy to `.env` (never commit it).
#
# EVERYTHING IS OPTIONAL FOR LOCAL DEV. With this file empty, Reelplane uses the
# docker-compose stack (`pnpm infra:up && pnpm infra:init`): local Postgres + RustFS.
# Fill in a section only when you create that account. `pnpm services` shows what
# each component is using and whether it is reachable.
#
# Free-tier and no-card status of every service: docs/SERVICES.md

# ---------------------------------------------------------------------------
# Postgres (database + job queue)  — Supabase, new FREE project
# ---------------------------------------------------------------------------
# 1. https://supabase.com/dashboard -> New project (use a NEW project, not your other app's).
#    Free plan: 2 active projects, 500 MB DB; pauses after 7 days without activity.
# 2. Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, port 5432).
#    Use session mode, not transaction mode (6543): the worker holds row locks + leases.
# 3. Replace [YOUR-PASSWORD] with the DB password you chose.
# Local default: postgres://reelplane:reelplane@localhost:54320/reelplane
DATABASE_URL=

# Server-side pepper for hashing API keys (HMAC-SHA256). Required in production,
# at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing API key.
API_KEY_PEPPER=

# ---------------------------------------------------------------------------
# Supabase Auth (dashboard + demo sign-in) — same Supabase project
# ---------------------------------------------------------------------------
# Project Settings -> API: copy the Project URL and the anon/publishable key.
# The service-role/secret key is server-only: never prefix it with NEXT_PUBLIC_.
# Sign-in is by email magic link. In Authentication -> URL Configuration, set the Site URL
# to your deployed app and add <your app>/auth/callback to the Redirect URLs.
# Without these, `next dev` runs the dashboard with no sign-in (you are the local developer,
# owner of the seeded projects); a production build shows "sign-in isn't configured".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The app's public URL, used in sign-in links. Required in production with Supabase Auth
# (sign-in links are never built from request headers there); `next dev` uses the request origin.
NEXT_PUBLIC_SITE_URL=
# Set to 1 to allow the no-sign-in local dashboard in a production build (never on Vercel).
# Anyone who can reach the server then has full dashboard access.
# REELPLANE_LOCAL_AUTH=1

# ---------------------------------------------------------------------------
# Object storage (S3-compatible) — Backblaze B2 by default
# ---------------------------------------------------------------------------
# Leave ALL STORAGE_* empty to use local RustFS. Switching provider = editing these only.
#
# Backblaze B2 (10 GB free, sign-up advertised as "no credit card required"):
# 1. https://www.backblaze.com/sign-up/cloud-storage -> create account.
# 2. B2 Cloud Storage -> Buckets -> Create a Bucket: name e.g. reelplane-<you>, Private.
#    Note the "Endpoint" shown on the bucket, e.g. s3.us-west-004.backblazeb2.com.
# 3. Application Keys -> Add a New Application Key: restrict to that bucket,
#    Read and Write. Copy keyID + applicationKey (shown once).
# 4. Run `pnpm infra:init` once to apply CORS rules for browser uploads.
# Egress: free up to 3x your stored data per month, then $0.01/GB. Free when
# served through Cloudflare (Bandwidth Alliance) -> set STORAGE_PUBLIC_BASE_URL.
#
# Cloudflare R2 alternative: STORAGE_PROVIDER=r2,
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_REGION=auto
#   (zero egress, but enabling R2 asks for a card/PayPal: see docs/SERVICES.md)
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for RustFS/MinIO; leave empty for B2/R2/S3
STORAGE_FORCE_PATH_STYLE=
# Optional CDN in front of the bucket for HLS playback (e.g. a Cloudflare-proxied domain)
STORAGE_PUBLIC_BASE_URL=
# Comma-separated origins allowed to PUT upload parts directly to the bucket
ALLOWED_UPLOAD_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Upstash Redis (optional: rate limits + hot-feed cache)
# ---------------------------------------------------------------------------
# Without it, rate limiting falls back to Postgres.
# 1. https://console.upstash.com -> Create Database (Redis), free plan:
#    500K commands/month, 256 MB.
# 2. Open the DB -> "REST API" section: copy UPSTASH_REDIS_REST_URL and _TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Transcoding worker host — see docs/SERVICES.md before creating anything
# ---------------------------------------------------------------------------
# Hugging Face Docker Spaces now require a paid (PRO) plan, so they are NOT free.
# The worker runs on your laptop with `docker compose` (instructions arrive in Phase 4)
# or on any VM. Hugging Face token only needed if you choose to pay for a Space.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Webhooks (sent by the worker) — optional tuning, defaults shown
# ---------------------------------------------------------------------------
# WEBHOOK_TIMEOUT=10s
# WEBHOOK_MAX_ATTEMPTS=10
# WEBHOOK_RETRY_BASE=30s
# WEBHOOK_RETRY_MAX=1h
# Endpoints that resolve to private/loopback addresses are refused (SSRF protection).
# Set to true ONLY on your laptop, to test with a receiver on localhost.
# WEBHOOK_ALLOW_PRIVATE_URLS=false

# ---------------------------------------------------------------------------
# Vercel (hosts apps/web) — no key needed here
# ---------------------------------------------------------------------------
# Hobby plan, no card. Import the GitHub repo at https://vercel.com/new,
# set Root Directory = apps/web, and paste the variables above into
# Project -> Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# npm (publishing @reelplane/sdk-react) — no key needed here
# ---------------------------------------------------------------------------
# https://www.npmjs.com/signup, enable 2FA, then `npm login` locally.
# Create the free "reelplane" org at https://www.npmjs.com/org/create so the
# @reelplane scope is yours before publishing.
