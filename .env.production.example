# Production settings. Copy to `.env.production` (gitignored) and fill in at launch, following
# docs/LAUNCH-CHECKLIST.md (step numbers in brackets). Used locally by the `pnpm prod:*`
# commands (migrate, seed, worker); the variables marked [Vercel] also go into Vercel.

# --- Supabase project (Settings -> API) [step 1] ------------------------------- [Vercel]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database [step 2] --------------------------------------------------------
# Session pooler (port 5432): for prod:migrate, prod:seed and prod:worker on your laptop.
# As Supabase shows it, no ?sslmode: TLS with Supabase's CA is built in (LAUNCH-CHECKLIST step 2).
DATABASE_URL=
# Vercel gets the TRANSACTION pooler (port 6543) as its DATABASE_URL instead, plus:
# DATABASE_POOL_MAX=2                                                             [Vercel]

# --- Storage: Supabase Storage, S3 connection [step 3] ------------------------ [Vercel]
STORAGE_PROVIDER=supabase
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=reelplane
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
# Supabase free plan: 50 MB per file.
UPLOAD_MAX_BYTES=52428800

# --- Secrets you generate [step 4] -------------------------------------------- [Vercel]
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"  (once each)
API_KEY_PEPPER=
CRON_SECRET=

# --- The deployed app [steps 7-9] ---------------------------------------------- [Vercel]
NEXT_PUBLIC_SITE_URL=
TRUSTED_PROXY=vercel
# Printed by `pnpm prod:seed` [step 11]:
NEXT_PUBLIC_DEMO_PUBLISHABLE_KEY=

# --- Seeding only (not Vercel) [step 10] ---------------------------------------
# Your Supabase user id (Authentication -> Users) after signing in to production once.
SEED_OWNER_ID=
